{
  "name": "texlite",
  "version": "0.7.8",
  "description": "A lightweight local-first collaborative LaTeX workspace",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SWUFE-DB-Group/TexLite.git"
  },
  "homepage": "https://github.com/SWUFE-DB-Group/TexLite",
  "bugs": {
    "url": "https://github.com/SWUFE-DB-Group/TexLite/issues"
  },
  "keywords": [
    "latex",
    "overleaf",
    "collaboration",
    "tex"
  ],
  "bin": {
    "texlite": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "preview.png",
    "texlite.config.example.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart texlite --update-env",
    "pm2:stop": "pm2 stop texlite",
    "pm2:delete": "pm2 delete texlite",
    "pm2:logs": "pm2 logs texlite",
    "pm2:save": "pm2 save",
    "init": "tsx src/server/cli.ts init",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@replit/codemirror-vim": "^6.4.0",
    "better-sqlite3": "^13.0.2",
    "bibtex-tidy": "1.14.0",
    "diff-match-patch": "^1.0.5",
    "fastify": "^5.4.0",
    "harper.js": "^2.7.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lib0": "^0.2.117",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "pm2": "^7.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.6.1",
    "react-resizable-panels": "^2.1.9",
    "tex-fmt": "0.5.7-npm.1",
    "ws": "^8.21.1",
    "y-codemirror.next": "^0.3.5",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.4"
  }
}
